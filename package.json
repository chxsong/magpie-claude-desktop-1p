  },
  "devDependencies": {
    "node-forge": "1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chxsong/magpie-claude-desktop-1p.git"
  },
  "homepage": "https://github.com/chxsong/magpie-claude-desktop-1p#readme"
