{
  "name": "magpie-claude-desktop-1p",
  "version": "0.1.0+03",
  "description": "Use Magpie models in Claude Desktop's first-party Code sessions",
  "type": "module",
  "main": "./dist/index.mjs",
  "files": [
    "dist",
    "agent.js",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.zh-CN.md",
    "assets"
  ],
  "license": "MIT",
  "keywords": [
    "magpie-plugin",
    "magpie",
    "claude-desktop",
    "opencode-plugin"
  ],
  "scripts": {
